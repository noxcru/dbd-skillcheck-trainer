<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>DBD Skill Check Trainer</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <h1>DBD Skill Check Trainer</h1>

  <div class="skillcheck-container">
    <div class="circle">

      <div class="success-zone good-zone"></div>
      <div class="success-zone great-zone"></div>

      <div class="pointer" id="pointer"></div>

    </div>
  </div>

  <p id="result">Press SPACE when the pointer hits the zone!</p>

  <button onclick="startSkillCheck()">Start Skill Check</button>

  <script src="script.js"></script>

</body>
</html>

body {
  background-color: #111;
  color: white;
  font-family: Arial, sans-serif;
  text-align: center;
  margin-top: 40px;
}

h1 {
  margin-bottom: 30px;
}

.skillcheck-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 30px;
}

.circle {
  position: relative;
  width: 320px;
  height: 320px;
  border: 8px solid #555;
  border-radius: 50%;
  background: #1b1b1b;
}

.pointer {
  position: absolute;
  width: 4px;
  height: 150px;
  background: red;
  left: 158px;
  top: 10px;
  transform-origin: bottom center;
  border-radius: 5px;
}

.success-zone {
  position: absolute;
  left: 145px;
  border-radius: 10px;
}

.good-zone {
  width: 30px;
  height: 70px;
  background: #cccccc;
  top: -15px;
}

.great-zone {
  width: 14px;
  height: 40px;
  background: white;
  top: -3px;
  left: 153px;
}

button {
  padding: 12px 24px;
  font-size: 18px;
  border: none;
  border-radius: 10px;
  background: #e11d48;
  color: white;
  cursor: pointer;
}

button:hover {
  opacity: 0.9;
}

#result {
  font-size: 24px;
  margin-bottom: 20px;
}

