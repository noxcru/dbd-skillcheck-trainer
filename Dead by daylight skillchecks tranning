const pointer = document.getElementById("pointer");
const result = document.getElementById("result");

let angle = 0;
let speed = 5;
let active = false;
let animationFrame;

function startSkillCheck() {

  cancelAnimationFrame(animationFrame);

  angle = 0;
  active = true;

  result.innerText = "GO!";

  rotatePointer();
}

function rotatePointer() {

  if (!active) return;

  angle += speed;

  pointer.style.transform = `rotate(${angle}deg)`;

  if (angle >= 360) {
    active = false;
    result.innerText = "MISS!";
    return;
  }

  animationFrame = requestAnimationFrame(rotatePointer);
}

document.addEventListener("keydown", (e) => {

  if (e.code !== "Space") return;

  if (!active) return;

  active = false;

  const hitAngle = angle % 360;

  /*
    GREAT = 354-360 OR 0-6
    GOOD = 345-353 OR 7-15
  */

  if (hitAngle >= 354 || hitAngle <= 6) {

    result.innerText = "GREAT SKILL CHECK!";

  } else if (
    (hitAngle >= 345 && hitAngle < 354) ||
    (hitAngle > 6 && hitAngle <= 15)
  ) {

    result.innerText = "GOOD SKILL CHECK!";

  } else {

    result.innerText = "MISS!";
  }
});
